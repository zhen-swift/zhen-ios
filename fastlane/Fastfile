# Zhen for iPad's lanes. Local commands are CI's commands.
#
#   bundle exec fastlane test    unit + UI, results in fastlane/test_output
#   bundle exec fastlane unit    unit only
#   bundle exec fastlane ui      UI only (drives the simulator, not this Mac)
#
# DEVICE picks the simulator: `DEVICE="iPad Air 13-inch (M4)" bundle exec fastlane unit`.

default_platform(:ios)

PROJECT = "Zhen.xcodeproj"
SCHEME = "Zhen"
OUTPUT = "fastlane/test_output"
# A simulator needs no signing, and forks have no team.
SIGNING = "CODE_SIGNING_ALLOWED=NO"

platform :ios do
  private_lane :run_suite do |options|
    scan(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("DEVICE", "iPad Pro 13-inch (M5)"),
      only_testing: options[:only],
      output_directory: OUTPUT,
      output_types: "junit",
      result_bundle: true,
      cloned_source_packages_path: ENV["SPM_CACHE_PATH"],
      xcargs: SIGNING,
      fail_build: true
    )
  end

  desc "Unit and UI tests"
  lane :test do
    run_suite
  end

  desc "Unit tests only"
  lane :unit do
    run_suite(only: ["ZhenTests"])
  end

  desc "UI tests only"
  lane :ui do
    run_suite(only: ["ZhenUITests"])
  end
end
